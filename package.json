{
  "name": "gift-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix web ci && npm --prefix web run build",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply gift-list --local",
    "db:migrate:remote": "wrangler d1 migrations apply gift-list --remote",
    "user:create": "node scripts/create-user.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
